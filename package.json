{
  "name": "hqsf-client",
  "version": "0.0.2",
  "description": "荒启科幻（huangqisf.com）桌面客户端 —— 写作-阅读-评审 一站式方案",
  "homepage": "https://www.huangqisf.com/",
  "desktopName": "huangqi-scifi",
  "main": "out/main/index.js",
  "author": "之于言者",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:linux": "electron-vite build && electron-builder --linux; rc=$?; node scripts/archive-release.mjs || rc=1; exit $rc",
    "build:win": "electron-vite build && node scripts/win-prebuild.mjs apply && electron-builder --win; rc=$?; node scripts/win-prebuild.mjs restore || rc=1; node scripts/archive-release.mjs || rc=1; exit $rc"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^34.5.8",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "electron-winstaller@5.4.0": true,
    "electron@34.5.8": true,
    "better-sqlite3@12.11.1": true,
    "turndown@7.2.4": true
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "better-sqlite3": "^12.11.1",
    "codemirror": "^6.0.2",
    "markdown-it": "^15.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turndown": "^7.2.4",
    "zustand": "^5.0.14"
  }
}

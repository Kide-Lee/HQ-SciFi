{
  "name": "hqsf-client",
  "version": "2.0.16",
  "description": "黄芪饮片 —— 荒启科幻（huangqisf.com）桌面客户端，写作-阅读-评审 一站式方案",
  "homepage": "https://www.huangqisf.com/",
  "desktopName": "huangqi-scifi",
  "author": "之于言者",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:web": "vite build --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.web.json",
    "test:lib-rules": "node --experimental-strip-types scripts/test-lib-rules.mjs",
    "test:draft-cache": "node --experimental-strip-types scripts/test-draft-cache.mjs",
    "test:read-history": "node --experimental-strip-types scripts/test-read-history.mjs",
    "gen:markdown-corpus": "node scripts/gen-markdown-corpus.mjs",
    "dev:web": "vite --config vite.web.config.ts",
    "dev:app": "cargo tauri dev --features devtools"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@milkdown/kit": "^7.22.0",
    "@milkdown/plugin-math": "^7.5.9",
    "@milkdown/prose": "^7.22.0",
    "@milkdown/react": "^7.22.0",
    "@milkdown/theme-nord": "^7.22.0",
    "codemirror": "^6.0.2",
    "katex": "^0.18.4",
    "lucide-react": "^1.30.0",
    "markdown-it": "^15.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turndown": "^7.2.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "turndown@7.2.4": true
  }
}
